+ * Nao ha promessa aqui: se o navegador nao entregar o codificador de
+ * hardware, ele cai no OpenH264 por software e nada piora. Quem confirma
+ * e o campo `motor` da medicao, que passa a dizer o nome do motor em uso.
+ * `dp_tela_codec=vp8` volta atras sem build novo.
+ */
+function telaCodec(): "h264" | "vp8" {
+  try {
+    return localStorage.getItem("dp_tela_codec") === "vp8" ? "vp8" : "h264";
