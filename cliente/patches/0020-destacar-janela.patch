+/**
+ * Tirar uma câmera ou tela da grade para uma janela própria.
+ *
+ * A janela é aberta com `window.open` na MESMA origem, o que faz dela um
+ * documento diferente mas com o mesmo contexto de JavaScript. É isso que
+ * permite entregar a faixa de mídia para ela: uma janela do Tauri, ou
+ * qualquer coisa de outra origem, teria contexto próprio e não haveria
+ * como passar um `MediaStream`.
+ *
+ * Por que `window.open` e não `documentPictureInPicture`: o segundo dá uma
+ * janela sempre no topo, mas **uma por aba**, e quem escolhe a posição é o
+ * navegador. Aqui o objetivo é a pessoa arrumar VÁRIAS transmissões no
+ * lugar exato da tela dela. Fica como possível acréscimo depois — o
+ * caminho do código é quase o mesmo, muda só como a janela é obtida.
+ */
+
+import type { ElementInfo, RemoteVideoTrack } from "livekit-client";
+
+const ABERTAS = new Map<string, Window>();
+
+/** Quem observa a lista para acender/apagar o item do menu */
+type Ouvinte = (ids: string[]) => void;
+const ouvintes = new Set<Ouvinte>();
+
+function avisar() {
+  const ids = [...ABERTAS.keys()];
+  for (const o of ouvintes) o(ids);
+}
+
+export function aoMudarDestacados(o: Ouvinte) {
+  ouvintes.add(o);
+  return () => ouvintes.delete(o);
+}
+
+export function estaAberta(id: string) {
+  const j = ABERTAS.get(id);
+  return !!j && !j.closed;
+}
+
+/**
+ * Copia o estilo da página para a janela nova.
+ *
+ * O documento nasce vazio: sem isto o vídeo aparece, mas sem nenhuma das
+ * regras da aplicação — e a fonte dos ícones some, o que faz os símbolos
+ * virarem as palavras deles escritas por extenso.
+ */
+function copiarEstilos(destino: Window) {
+  for (const folha of Array.from(document.styleSheets)) {
+    try {
+      const regras = Array.from(folha.cssRules)
+        .map((r) => r.cssText)
+        .join("\n");
+      const el = destino.document.createElement("style");
+      el.textContent = regras;
+      destino.document.head.appendChild(el);
+    } catch {
+      // Folha de outra origem não deixa ler as regras; refazemos como link.
+      if (folha.href) {
+        const el = destino.document.createElement("link");
+        el.rel = "stylesheet";
+        el.href = folha.href;
+        destino.document.head.appendChild(el);
+      }
+    }
+  }
+}
+
+type ComPiP = Window & {
+  documentPictureInPicture?: {
+    requestWindow: (o?: {
+      width?: number;
+      height?: number;
+    }) => Promise<Window>;
+  };
+};
+
+/**
+ * Consegue uma janela, pelo caminho que este ambiente permitir.
+ *
+ * `window.open` é a primeira escolha: dá VÁRIAS janelas e a pessoa
+ * posiciona cada uma onde quiser. É o que atende o pedido.
+ *
+ * Só que ele não funciona em todo lugar. No aplicativo de desktop (Tauri)
+ * o pedido passa por um manipulador de janela nova que decide permitir,
+ * negar ou abrir por fora — e mesmo se permitisse, seria outro webview,
+ * com contexto de JavaScript próprio, para onde não há como entregar um
+ * `MediaStream`. Na prática ele devolve nulo e nada acontece.
+ *
+ * Daí a reserva: `documentPictureInPicture` hospeda DOM da própria página,
+ * então o contexto continua o mesmo. Custa o limite de **uma** janela por
+ * documento — menos do que o pedido, e muito mais do que nada.
+ */
+async function abrirJanela(id: string): Promise<Window | null> {
+  const janela = window.open(
+    "",
+    `dp-destaque-${id}`,
+    "popup=yes,width=720,height=440",
+  );
+  if (janela) return janela;
+
+  const pip = (window as ComPiP).documentPictureInPicture;
+  if (!pip) return null;
+
+  try {
+    return await pip.requestWindow({ width: 720, height: 440 });
+  } catch {
+    // Já existe uma janela de Picture-in-Picture, ou o usuário recusou.
+    return null;
+  }
+}
+
+export type PedidoDestaque = {
+  /** Identificador estável da faixa, o mesmo que o estado de voz usa */
+  id: string;
+  /** Título da janela: nome de quem transmite */
+  titulo: string;
+  /** A faixa de mídia a exibir */
+  stream: MediaStream;
+  /**
+   * A faixa do SDK, quando for de outra pessoa.
+   *
+   * Serve para contar ao `adaptiveStream` que este vídeo continua sendo
+   * exibido — ver `observarNaJanela`. Faixa própria não tem assinatura
+   * nem camadas, então vem indefinida.
+   */
+  faixa?: RemoteVideoTrack;
+  /** Chamado quando a janela fecha, por qualquer motivo */
+  aoFechar: () => void;
+};
+
+/**
+ * Conta ao `adaptiveStream` que este vídeo continua sendo exibido.
+ *
+ * O SDK decide se uma faixa deve seguir chegando observando os elementos
+ * em que ela foi encaixada — visibilidade por `IntersectionObserver` e
+ * tamanho por `ResizeObserver`. Os dois observadores são únicos e nascem
+ * no documento principal. O nosso vídeo vive em OUTRO documento: o
+ * observador nunca o vê intersectar coisa nenhuma, o SDK conclui que
+ * ninguém está olhando e manda o servidor parar de enviar — com a janela
+ * aberta na frente da pessoa.
+ *
+ * Some ainda um segundo motivo: destacar quase sempre significa ir olhar
+ * outra coisa, então a aba principal fica escondida. Aba escondida pausa
+ * vídeo (`pauseVideoInBackground`), e isso pausaria a janela destacada
+ * junto.
+ *
+ * `observeElementInfo` é a porta que o SDK deixa aberta justamente para
+ * isto: quem sabe responder por um elemento responde. Marcamos o vídeo
+ * como `pictureInPicture` porque é literalmente o que ele é — imagem
+ * fora do documento, que continua à vista quando a aba não está — e é
+ * essa marca que o SDK respeita para não pausar em segundo plano.
+ *
+ * Enquanto a janela está minimizada ou fechada, respondemos que não está
+ * visível, e a economia volta a valer.
+ */
+function observarNaJanela(
+  janela: Window,
+  video: HTMLVideoElement,
+): ElementInfo {
+  let mudouEm: number | undefined = 0;
+
+  const aparente = () => !janela.closed && !janela.document.hidden;
+
+  const aoMudar = () => {
+    mudouEm = Date.now();
+    info.handleVisibilityChanged?.();
+  };
+  const aoRedimensionar = () => info.handleResize?.();
+
+  const info: ElementInfo = {
+    element: video,
+    width: () => video.clientWidth,
+    height: () => video.clientHeight,
+    get visible() {
+      return aparente();
+    },
+    get pictureInPicture() {
+      return aparente();
+    },
+    get visibilityChangedAt() {
+      return mudouEm;
+    },
+    observe() {
+      janela.addEventListener("resize", aoRedimensionar);
+      janela.document.addEventListener("visibilitychange", aoMudar);
+      janela.addEventListener("pagehide", aoMudar);
+    },
+    stopObserving() {
+      janela.removeEventListener("resize", aoRedimensionar);
+      janela.document.removeEventListener("visibilitychange", aoMudar);
+      janela.removeEventListener("pagehide", aoMudar);
+    },
+  };
+
+  return info;
+}
+
+/**
+ * Abre a janela e devolve se conseguiu.
+ *
+ * Devolver `false` não é detalhe: bloqueador de pop-up recusa em silêncio,
+ * e sem esse retorno o quadro sairia da grade sem aparecer em lugar nenhum
+ * — a transmissão simplesmente sumiria da tela da pessoa.
+ */
+export async function destacar(pedido: PedidoDestaque): Promise<boolean> {
+  const existente = ABERTAS.get(pedido.id);
+  if (existente && !existente.closed) {
+    existente.focus();
+    return true;
+  }
+
+  const janela = await abrirJanela(pedido.id);
+  if (!janela) return false;
+
+  janela.document.title = pedido.titulo;
+  copiarEstilos(janela);
+
+  const corpo = janela.document.body;
+  corpo.style.margin = "0";
+  corpo.style.background = "#000";
+  corpo.style.height = "100vh";
+  corpo.style.display = "grid";
+
+  const video = janela.document.createElement("video");
+  video.autoplay = true;
+  video.playsInline = true;
+  // Sem mudo o áudio sairia duas vezes: a janela principal já reproduz.
+  video.muted = true;
+  video.srcObject = pedido.stream;
+  video.style.width = "100%";
+  video.style.height = "100%";
+  video.style.objectFit = "contain";
+  corpo.appendChild(video);
+
+  // Precisa vir depois de o vídeo estar no documento: o SDK mede o
+  // elemento assim que passa a observá-lo.
+  const info = observarNaJanela(janela, video);
+  pedido.faixa?.observeElementInfo(info);
+
+  ABERTAS.set(pedido.id, janela);
+  avisar();
+
+  const fechar = () => {
+    // Devolver a faixa ao regime normal antes de avisar quem espera: a
+    // grade vai encaixá-la de novo, e duas contabilidades para o mesmo
+    // vídeo deixariam a janela fechada respondendo por ele.
+    pedido.faixa?.stopObservingElementInfo(info);
+    ABERTAS.delete(pedido.id);
+    avisar();
+    pedido.aoFechar();
+  };
+
+  janela.addEventListener("pagehide", fechar);
+  // `pagehide` não dispara em todo navegador quando a janela é fechada pelo
+  // botão do sistema; a sondagem é a rede de segurança.
+  const vigia = window.setInterval(() => {
+    if (janela.closed) {
+      window.clearInterval(vigia);
+      fechar();
+    }
+  }, 1000);
+
+  return true;
+}
+
+/** Fecha uma janela específica */
+export function recolher(id: string) {
+  const j = ABERTAS.get(id);
+  if (j && !j.closed) j.close();
+  ABERTAS.delete(id);
+  avisar();
+}
+
+/** Fecha todas — usado quando a chamada termina */
+export function recolherTudo() {
+  for (const [, j] of ABERTAS) {
+    try {
+      if (!j.closed) j.close();
+    } catch {
+      /* janela já foi embora */
+    }
+  }
+  ABERTAS.clear();
+  avisar();
+}
