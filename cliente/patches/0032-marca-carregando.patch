+
+/** Comprimento do traco, medido com `getTotalLength` no proprio caminho. */
+const COMPRIMENTO = 9058;
+
+/**
+ * Azul e roxo da marca, amostrados do PNG: o gradiente e diagonal, do canto
+ * superior esquerdo ao inferior direito.
+ */
+export const AZUL = "#179EF0",
+  ROXO = "#8249DB";
+
+/**
+ * Duracao de um ciclo completo.
+ *
+ * Exportado porque a tela de entrada segura a troca por dois ciclos: com o
+ * numero repetido em dois lugares, mudar o ritmo da animacao aqui deixaria a
+ * tela liberando no meio de um ciclo, sem ninguem perceber por que.
+ */
+export const CICLO_MARCA_MS = 1800;
+
+const CSS = `
+@keyframes dp-marca-traco {
+  0%   { stroke-dashoffset: ${COMPRIMENTO}; opacity: 1 }
+  55%  { stroke-dashoffset: 0; opacity: 1 }
+  92%  { stroke-dashoffset: 0; opacity: 1 }
+  100% { stroke-dashoffset: 0; opacity: 0 }
+}
+@keyframes dp-marca-corpo {
+  0%, 45%  { opacity: .12 }
+  72%, 92% { opacity: 1 }
+  100%     { opacity: .12 }
+}
+.dp-marca-traco {
+  fill: none;
+  stroke-width: 12;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+  stroke-dasharray: ${COMPRIMENTO};
+  animation: dp-marca-traco ${CICLO_MARCA_MS}ms ease-in-out infinite;
+}
+.dp-marca-corpo { animation: dp-marca-corpo ${CICLO_MARCA_MS}ms ease-in-out infinite }
+
+/*
+  Quem pediu menos movimento recebe a marca parada, e nao um piscar mais
+  lento: o proposito aqui e dizer "estamos carregando", e a marca sozinha ja
+  diz isso no lugar onde um avatar ou um conteudo deveria estar.
+*/
+@media (prefers-reduced-motion: reduce) {
+  .dp-marca-traco { display: none }
+  .dp-marca-corpo { animation: none; opacity: .5 }
+}
+`;
+
+/**
+ * A folha de estilo entra uma vez so.
+ *
+ * Este componente aparece em lista -- um por participante enquanto os perfis
+ * carregam -- e um `<style>` dentro do SVG viraria uma copia por instancia.
+ */
+let estiloPosto = false;
+function garantirEstilo() {
+  if (estiloPosto || typeof document === "undefined") return;
+  estiloPosto = true;
+  const el = document.createElement("style");
+  el.id = "dp-marca-carregando";
+  el.textContent = CSS;
+  document.head.append(el);
+}
+
+/**
+ * Carregando, com a marca se remontando.
+ *
+ * O contorno se desenha, o preenchimento entra atras dele e o ciclo recomeca.
+ * Nunca fica vazio: fora do momento cheio a marca continua ali, fantasma, para
+ * o lugar nao piscar entre um ciclo e outro.
+ *
+ * Sem texto de proposito -- e o elemento grafico que carrega o recado.
+ */
+export function MarcaCarregando(props: { size?: number; title?: string }) {
+  garantirEstilo();
+
+  // O gradiente e referenciado por id. Com um id fixo, todas as instancias
+  // apontariam para o primeiro SVG do documento -- e desmontar justamente ele
+  // deixaria as outras sem cor nenhuma.
+  const id = createUniqueId();
+  const lado = () => props.size ?? 48;
+
+  return (
+    <svg
+      role="img"
+      aria-label={props.title ?? "Carregando"}
+      width={lado()}
+      height={Math.round((lado() * 976) / 1124)}
+      viewBox="0 0 1124 976"
+      xmlns="http://www.w3.org/2000/svg"
+    >
+      <defs>
+        <linearGradient
+          id={id}
+          x1="0"
+          y1="0"
+          x2="1124"
+          y2="976"
+          gradientUnits="userSpaceOnUse"
+        >
+          <stop offset="0" stop-color={AZUL} />
+          <stop offset="1" stop-color={ROXO} />
+        </linearGradient>
+      </defs>
+      <path class="dp-marca-corpo" fill={`url(#${id})`} d={MARCA} />
+      <path class="dp-marca-traco" stroke={`url(#${id})`} d={MARCA} />
+    </svg>
+  );
+}
+
+
+/**
+ * A marca parada, sem animacao.
+ *
+ * Mesmo caminho vetorial da versao que carrega -- e o ponto de reutilizar:
+ * duas copias do `d` divergiriam no dia em que a marca mudasse, e ninguem
+ * lembraria da segunda. Aqui ela e so identidade, nao espera: onde nada
+ * esta carregando, animar seria ruido.
+ */
+export function Marca(props: { size?: number; title?: string }) {
+  const id = createUniqueId();
+  const lado = () => props.size ?? 64;
+
+  return (
+    <svg
+      role="img"
+      aria-label={props.title ?? "Dois Papo"}
+      width={lado()}
+      height={Math.round((lado() * 976) / 1124)}
+      viewBox="0 0 1124 976"
+      xmlns="http://www.w3.org/2000/svg"
+    >
+      <defs>
+        <linearGradient
+          id={id}
+          x1="0"
+          y1="0"
+          x2="1124"
+          y2="976"
+          gradientUnits="userSpaceOnUse"
+        >
+          <stop offset="0" stop-color={AZUL} />
+          <stop offset="1" stop-color={ROXO} />
+        </linearGradient>
+      </defs>
+      <path fill={`url(#${id})`} d={MARCA} />
+    </svg>
+  );
+}
