@@ -0,0 +1,218 @@
+import { Show, createSignal, onCleanup, onMount } from "solid-js";
+
+import { Trans, useLingui } from "@lingui-solid/solid/macro";
+import { cva } from "styled-system/css";
+import { styled } from "styled-system/jsx";
+
+import { useVoice } from "@revolt/rtc";
+import { Symbol } from "@revolt/ui/components/utils/Symbol";
+
+import { VoiceCallCardActions } from "./callCard/VoiceCallCardActions";
+
+/** How often to re-read the round trip time, in milliseconds */
+const PING_INTERVAL = 2000;
+
+/**
+ * Persistent voice controls, pinned to the foot of the channel list.
+ *
+ * These controls used to live inside the floating call card, which meant they
+ * only existed while that card was on screen — and the card sat on top of the
+ * message history. Anchoring them here separates the two concerns: the card is
+ * for looking at people, this is for operating the call, and it stays put
+ * while you read any channel.
+ */
+export function VoiceDock() {
+  const voice = useVoice();
+  const { t } = useLingui();
+
+  // Built by concatenation rather than macro interpolation. A compiled
+  // catalogue stores a message with a placeholder as a list of fragments, and
+  // this deployment swaps translations by whole string — an interpolated
+  // message would be the one line in the dock stuck in English.
+  const latencyLabel = () => t`Latency`;
+
+  // Polled, not reactive: the round trip time is read straight off the
+  // signalling client, which updates it on its own ping schedule without
+  // telling anyone.
+  const [ms, setMs] = createSignal<number | undefined>();
+
+  /** Azul enquanto conecta, verde conectado, vermelho quando falha. */
+  const estadoVisual = () => {
+    switch (voice.state()) {
+      case "CONNECTED":
+        return "conectado" as const;
+      case "CONNECTING":
+      case "RECONNECTING":
+        return "conectando" as const;
+      case "DISCONNECTED":
+        return "falha" as const;
+      default:
+        return "parado" as const;
+    }
+  };
+
+  /**
+   * O texto que sai ao passar o mouse.
+   *
+   * Sempre ha o que dizer: com leitura, o tempo de ida e volta; sem
+   * leitura ainda, o proprio estado. Uma dica que so existe as vezes
+   * ensina a pessoa a nao passar o mouse ali.
+   */
+  const dica = () => {
+    const v = ms();
+    if (v) return `${latencyLabel()}: ${v} ms`;
+    switch (voice.state()) {
+      case "CONNECTING":
+        return t`Connecting`;
+      case "RECONNECTING":
+        return t`Reconnecting`;
+      case "DISCONNECTED":
+        return t`Connection lost`;
+      default:
+        return t`Measuring…`;
+    }
+  };
+
+  onMount(() => {
+    const read = () => setMs(voice.ping());
+    read();
+    const timer = setInterval(read, PING_INTERVAL);
+    onCleanup(() => clearInterval(timer));
+  });
+
+  return (
+    <Show when={voice.channel()}>
+      <Dock>
+        <Line>
+          {/*
+            Um <div> de verdade, e nao o styled().
+
+            Diretiva `use:` no Solid so se liga a elemento DOM nativo. Num
+            componente ela vira uma prop inerte, a menos que o componente
+            a repasse de proposito -- e o styled() do panda nao repassa.
+            A dica estava pendurada num styled() e por isso NUNCA aparecia,
+            por mais que houvesse leitura de ping para mostrar.
+          */}
+          <div
+            class={statusClasse({ estado: estadoVisual() })}
+            use:floating={{
+              tooltip: { placement: "top", content: dica() },
+            }}
+          >
+            <Symbol size={18}>{symbol(voice.state())}</Symbol>
+            <Label>{label(voice.state())}</Label>
+          </div>
+        </Line>
+        <ChannelLine href={voice.channel()!.path}>
+          <Symbol size={16}>headset_mic</Symbol>
+          <Name>{voice.channel()!.name}</Name>
+        </ChannelLine>
+        <VoiceCallCardActions size="xs" dock />
+      </Dock>
+    </Show>
+  );
+}
+
+/** Icon for the current connection state */
+function symbol(state: string) {
+  return state === "DISCONNECTED" ? "wifi_tethering_error" : "wifi_tethering";
+}
+
+/** Wording for the current connection state */
+function label(state: string) {
+  switch (state) {
+    case "CONNECTED":
+      return <Trans>Voice connected</Trans>;
+    case "CONNECTING":
+      return <Trans>Connecting</Trans>;
+    case "RECONNECTING":
+      return <Trans>Reconnecting</Trans>;
+    case "DISCONNECTED":
+      return <Trans>Connection lost</Trans>;
+    default:
+      return null;
+  }
+}
+
+const Dock = styled("div", {
+  base: {
+    flexShrink: 0,
+
+    display: "flex",
+    flexDirection: "column",
+    gap: "var(--gap-xs)",
+
+    padding: "var(--gap-sm) var(--gap-md) var(--gap-md)",
+
+    background: "var(--md-sys-color-surface-container)",
+    color: "var(--md-sys-color-on-surface)",
+  },
+});
+
+const Line = styled("div", {
+  base: {
+    display: "flex",
+    alignItems: "center",
+    justifyContent: "space-between",
+    gap: "var(--gap-sm)",
+  },
+});
+
+const statusClasse = cva({
+  base: {
+    display: "flex",
+    alignItems: "center",
+    gap: "var(--gap-sm)",
+    minWidth: 0,
+    cursor: "default",
+
+    fontSize: "0.8125rem",
+    fontWeight: 600,
+  },
+  variants: {
+    estado: {
+      parado: { color: "var(--md-sys-color-outline)" },
+      // Azul da marca enquanto negocia a conexao.
+      conectando: { color: "#2E8BEB" },
+      // Verde quando a chamada esta de pe.
+      conectado: { color: "#3FB950" },
+      // Vermelho e reservado a FALHA, e so a ela. Se latencia ruim
+      // tambem pintasse de vermelho, a cor deixaria de responder "deu
+      // errado?" e passaria a responder "esta ruim?" -- duas perguntas
+      // diferentes na mesma tinta.
+      falha: { color: "var(--md-sys-color-error)" },
+    },
+  },
+});
+
+const Label = styled("span", {
+  base: {
+    overflow: "hidden",
+    whiteSpace: "nowrap",
+    textOverflow: "ellipsis",
+  },
+});
+
+const ChannelLine = styled("a", {
+  base: {
+    display: "flex",
+    alignItems: "center",
+    gap: "var(--gap-sm)",
+    minWidth: 0,
+
+    fontSize: "0.75rem",
+    color: "var(--md-sys-color-on-surface-variant)",
+
+    _hover: {
+      textDecoration: "underline!",
+    },
+  },
+});
+
+const Name = styled("span", {
+  base: {
+    overflow: "hidden",
+    whiteSpace: "nowrap",
+    textOverflow: "ellipsis",
+  },
+});
