+/**
+ * The writing form for one kind of submission
+ */
+function Formulario(props: {
+  tipo: Tipo;
+  cabecalhos: () => Record<string, string>;
+  onCancelar: () => void;
+  onEnviado: () => void;
+}) {
+  const { t } = useLingui();
+  const [titulo, setTitulo] = createSignal("");
+  const [texto, setTexto] = createSignal("");
+  const [enviando, setEnviando] = createSignal(false);
+  const [erro, setErro] = createSignal<string>();
+
+  const podeEnviar = () =>
+    titulo().trim().length > 0 && texto().trim().length > 0 && !enviando();
+
+  async function enviar() {
+    setErro();
+    setEnviando(true);
+    try {
+      const r = await fetch(`${API}/feedback`, {
+        method: "POST",
+        headers: props.cabecalhos(),
+        body: JSON.stringify({
+          tipo: props.tipo,
+          titulo: titulo(),
+          texto: texto(),
+        }),
+      });
+
+      if (r.status === 429) {
+        // Worth naming explicitly: "try again" with no reason reads as a
+        // fault in the app, when it is a deliberate ceiling.
+        setErro(t`You have sent a lot in the last hour. Try again later.`);
+      } else if (!r.ok) {
+        setErro(t`Could not send. Try again.`);
+      } else {
+        props.onEnviado();
+      }
+    } catch {
+      setErro(t`Could not send. Try again.`);
+    } finally {
+      setEnviando(false);
+    }
+  }
+
+  return (
+    <Bloco>
+      <Text class="title" size="medium">
+        <Switch>
+          <Match when={props.tipo === "sugestao"}>
+            <Trans>Send a suggestion</Trans>
+          </Match>
+          <Match when={props.tipo === "comentario"}>
+            <Trans>Leave a comment</Trans>
+          </Match>
+          <Match when={props.tipo === "bug"}>
+            <Trans>Report a problem</Trans>
           </Match>
         </Switch>
-      </CategoryButton.Group>
-    </Column>
+      </Text>
+
+      <TextField
+        variant="outlined"
+        placeholder={t`Summary`}
+        maxlength={120}
+        value={titulo()}
+        onInput={(e) => setTitulo((e.currentTarget as HTMLInputElement).value)}
+      />
+      <TextField
+        variant="outlined"
+        rows={5}
+        maxlength={4000}
+        placeholder={
+          props.tipo === "bug"
+            ? t`What did you do, what did you expect, and what happened?`
+            : t`Write freely.`
+        }
+        value={texto()}
+        onInput={(e) => setTexto((e.currentTarget as HTMLInputElement).value)}
+      />
+
+      <Show when={erro()}>
+        <Aviso>{erro()}</Aviso>
+      </Show>
+
+      <Linha>
+        <Button variant="text" onPress={props.onCancelar}>
+          <Trans>Cancel</Trans>
+        </Button>
+        <Button variant="filled" isDisabled={!podeEnviar()} onPress={enviar}>
+          <Show when={!enviando()} fallback={<Trans>Sending…</Trans>}>
+            <Trans>Send</Trans>
+          </Show>
+        </Button>
+      </Linha>
+    </Bloco>
   );
