+/**
+ * Selo vermelho com o numero de pedidos de entrada aguardando.
+ *
+ * So e montado para quem tem Gerenciar Servidor -- vive dentro do
+ * `<Show when={props.canManageServer}>` da engrenagem. Sem essa guarda,
+ * todo membro comum consultaria a cada minuto uma rota que so lhe
+ * responde 403.
+ *
+ * Consulta em laco, e nao por evento: o `EventV1` do bonfire e um enum
+ * fechado de 54 variantes, entao nao existe -- nem vai existir sem
+ * recompilar o backend -- um evento "pedido novo". Um `fetch` por minuto
+ * nesta escala e ruido; forjar evento seria manter a mao o formato de um
+ * enum Rust de terceiro.
+ */
+function ContadorDePedidos(props: { server: Server }) {
+  const client = useClient();
+  const [pendentes, setPendentes] = createSignal(0);
+
+  createEffect(() => {
+    const sid = props.server.id;
+    let vivo = true;
+
+    async function ler() {
+      try {
+        const [nome, valor] = client()!.authenticationHeader;
+        const r = await fetch(
+          `/api-convites/servidores/${sid}/solicitacoes/contagem`,
+          { headers: { [nome]: valor } },
+        );
+        if (!r.ok) return;
+        const corpo = await r.json();
+        if (vivo) setPendentes(Number(corpo.pendentes) || 0);
+      } catch {
+        // Rede fora do ar: mantem o numero anterior e tenta na proxima
+        // volta. Zerar aqui faria o selo piscar a cada oscilacao.
+      }
+    }
+
+    ler();
+    const relogio = setInterval(ler, 60000);
+    onCleanup(() => {
+      vivo = false;
+      clearInterval(relogio);
+    });
+  });
+
+  return (
+    <Show when={pendentes() > 0}>
+      <SeloDePedidos>{pendentes() > 9 ? "9+" : pendentes()}</SeloDePedidos>
+    </Show>
+  );
+}
+
