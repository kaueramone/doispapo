{$HOSTNAME} {
	# Access log estruturado: base do painel analítico.
	log {
		output file /data/acessos.log {
			roll_size 20mb
			roll_keep 6
		}
		format json
	}

	route /.well-known/stoat {
		uri strip_prefix /.well-known/stoat
		header {
			Access-Control-Allow-Origin *
		}
		file_server {
			root /stoat.json
		}
	}

	route /api* {
		uri strip_prefix /api
		reverse_proxy http://api:14702 {
			header_down Location "^/" "/api/"
		}
	}

	route /ws {
		uri strip_prefix /ws
		reverse_proxy http://events:14703 {
			header_down Location "^/" "/ws/"
		}
	}

	route /autumn* {
		uri strip_prefix /autumn
		reverse_proxy http://autumn:14704 {
			header_down Location "^/" "/autumn/"
		}
	}

	route /january* {
		uri strip_prefix /january
		reverse_proxy http://january:14705 {
			header_down Location "^/" "/january/"
		}
	}

	route /gifbox* {
		uri strip_prefix /gifbox
		reverse_proxy http://gifbox:14706 {
			header_down Location "^/" "/gifbox/"
		}
	}

	route /livekit* {
		uri strip_prefix /livekit
		reverse_proxy http://livekit:7880 {
			header_down Location "^/" "/livekit/"
		}
	}

	route /ingress* {
		uri strip_prefix /ingress
		reverse_proxy http://voice-ingress:8500 {
			header_down Location "^/" "/ingress/"
		}
	}

	# Pontos de entrada sempre revalidados: se o index.html ou o service
	# worker ficam em cache, nenhuma atualização chega ao navegador.
	@pontos_entrada path / /index.html /serviceWorker.js /versao.json /manifest.webmanifest
	header @pontos_entrada Cache-Control "no-cache, must-revalidate"

	# Serviço de cota de convites (Dois Papo)
	route /api-convites* {
		uri strip_prefix /api-convites
		reverse_proxy http://convites:8600
	}

	reverse_proxy http://web:5000
}

# ---------------------------------------------------------------------
# Landing page institucional — doispapo.com e www
# Conteúdo estático em /site (bind-mount via compose.override.yml)
# ---------------------------------------------------------------------
doispapo.com, www.doispapo.com {
	# Access log estruturado: base do painel analítico.
	log {
		output file /data/acessos.log {
			roll_size 20mb
			roll_keep 6
		}
		format json
	}

	# A landing precisa falar com o serviço de convites na mesma origem,
	# senão o formulário da fila esbarra em CORS.
	route /api-convites* {
		uri strip_prefix /api-convites
		reverse_proxy http://convites:8600
	}

	# Download sempre da última versão publicada. Fica no nosso domínio
	# para a página não depender de URL do GitHub — se um dia mudarmos de
	# hospedagem, troca-se aqui e o link divulgado continua valendo.
	redir /baixar/windows https://github.com/kaueramone/doispapo/releases/latest/download/DoisPapo-Setup.exe temporary
	redir /baixar        /#baixar temporary

	root * /site
	encode gzip zstd
	file_server

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
	}
	# assets imutáveis podem cachear forte; o HTML não
	@estatico path *.png *.ico *.svg *.woff2 *.jpg *.mp4 *.webm
	header @estatico Cache-Control "public, max-age=2592000, immutable"
	header /index.html Cache-Control "no-cache"
}

# ---------------------------------------------------------------------
# Portal do desenvolvedor — gerado a partir do OpenAPI da instância
# ---------------------------------------------------------------------
developers.doispapo.com {
	log {
		output file /data/acessos.log {
			roll_size 20mb
			roll_keep 6
		}
		format json
	}

	root * /developers
	encode gzip zstd
	file_server

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	@estatico path *.png *.svg *.ico
	header @estatico Cache-Control "public, max-age=604800"
	header /index.html Cache-Control "no-cache"
}

# ---------------------------------------------------------------------
# Painel administrativo — acesso restrito
# ---------------------------------------------------------------------
painel.doispapo.com {
	log {
		output file /data/acessos.log {
			roll_size 20mb
			roll_keep 6
		}
		format json
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		X-Robots-Tag "noindex, nofollow"
		Cache-Control "no-store"
	}

	reverse_proxy http://painel:8700
}
