{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dois Papo",
  "version": "0.1.0",
  "identifier": "com.doispapo.app",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "label": "principal",
        "title": "Dois Papo",
        "url": "https://chat.doispapo.com",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true,
        "theme": "Dark",
        "backgroundColor": "#101823"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["padrao"]
    },
    "trayIcon": {
      "id": "principal",
      "iconPath": "icons/bandeja.png",
      "iconAsTemplate": false,
      "tooltip": "Dois Papo"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "kaueramone",
    "copyright": "Dois Papo",
    "category": "SocialNetworking",
    "shortDescription": "Conversa de verdade, sem ruído.",
    "longDescription": "Plataforma de comunicação com texto, voz e compartilhamento de tela em 1080p.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false
      }
    }
  }
}
